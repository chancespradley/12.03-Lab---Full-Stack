extends layout

block content
  h1= title
  p Welcome to #{title}
  ol
    each val in todos
      li(class=val.completed > 0 ? 'done' : '')
        span.task= val.task + ' - '
        if val.completed > 0
          span Completed
        else
          span Not Completed
        form.inline(method='POST' action='/delete')
          input(type='hidden', name='id', value=val.id)
          button(type='submit') Delete
        details
          summary Edit
          form(method='POST' action='/edit')
            input(type='hidden', name='id', value=val.id)
            input(type='text', name='task', value=val.task, required, pattern='.*\\S.*', title='Task cannot be blank')
            label
              input(type='checkbox', name='completed', checked=val.completed > 0)
              |  Completed
            button(type='submit') Save

  hr
  h2 Add a new task
  form(method='POST' action='/create')
    label(for='task') Task:
    input(type='text', name='task', id='task', required, pattern='.*\\S.*', title='Task cannot be blank')
    button(type='submit') Create Task
